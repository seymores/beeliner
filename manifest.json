{
  "manifest_version": 3,
  "name": "Beeline Comfort Reader",
  "version": "1.0.0",
  "description": "Read articles with a configurable, line-guiding colour gradient.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Beeline Comfort Reader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["beeline.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
